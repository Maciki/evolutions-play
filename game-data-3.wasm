/ËíT+_PýA–bÞéÕ´ÆÉ‚¯Ð'xßxÏ„‹>’È©¼ë£Ÿ1-¼¥+26v¿\‚¶öéÛ”¶3ÚÈ;ö6úâN8|Züœ0¼ž@§3õ±µQœk¯Q`¿þ»GÂÓyf•wM;Fb4’	ã@RÚÒÒ‰þ‹S›␀ÿ–9}çj–‹¶Ê¿q]?ÿ´%~ÍÊÒÇjÏ…µr	©þô”„¦b-ÊüïÐ>ŠÒ^%>¯3Ïe\¸mžýFËÿî\ï^ß‡ï¥Ö€gþ+úµ+ÛdøäÓG<¼e/#ïF=KeVhxZPüÀÙBå$þ'£p!ÊšqNnÿübÚ…‹?ô¾$ß£üî×‡_×v½³7P0.i	ùTú–‰kRlj3Ã7&W‚áL{á9BÝBkù‰øõ—ÿ–T>¥?¹la1hF8`s²üëçÂ-œý±ò@¹wÇÃïb[Æ8´LAËÂk"äDh>•ßÑ—ãp£Q‚ë|ÏGød|Þ'¨]ç}o¥Û·€<´ýâöñr}¡¹³ÛÌ½L¡<ZÆgæö×?Þëé—ëÝ{åqâ␀␀␀␀␀␀// Inverted-hull outline: drawn as a next_pass, pushed out along normals and
// rendered back-faces only, giving creatures and props a crisp ink line.
shader_type spatial;
render_mode unshaded, cull_front, depth_draw_opaque, specular_disabled;

uniform vec4 color : source_color = vec4(0.05, 0.03, 0.08, 1.0);
uniform float width = 0.03;

void vertex() {
	VERTEX += NORMAL * width;
}

void fragment() {
	ALBEDO = color.rgb;
}
␀␀␀␀␀␀// Screen pass over the low-res game view: gentle grade, 4x4 ordered dither
// into a limited palette and a vignette, for a cohesive pixel-art finish.
shader_type canvas_item;

uniform float saturation = 1.06;
uniform float contrast = 1.05;
uniform float brightness = 1.0;
uniform float levels = 30.0;
uniform float pixel = 3.0;
uniform float vignette = 0.2;
uniform vec4 tint : source_color = vec4(1.0);

const float BAYER[16] = float[](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);

void fragment() {
	vec3 col = texture(TEXTURE, UV).rgb;
	float l = dot(col, vec3(0.299, 0.587, 0.114));
	col = mix(vec3(l), col, saturation);
	col = (col - 0.5) * contrast + 0.5;
	col *= brightness * tint.rgb;
	ivec2 p = ivec2(mod(floor(FRAGCOORD.xy / pixel), 4.0));
	float d = (BAYER[p.y * 4 + p.x] / 16.0 - 0.5) / levels;
	col = floor((col + d) * levels + 0.5) / levels;
	vec2 q = UV - 0.5;
	col *= 1.0 - vignette * dot(q, q) * 2.2;
	COLOR = vec4(clamp(col, 0.0, 1.0), 1.0);
}
␀␀␀shader_type spatial;
render_mode specular_disabled;
#include "res://shaders/toon.gdshaderinc"
␀␀// Shared toon lighting for creatures, props and ground: hard light/shadow
// bands with a hue-shifted shadow colour (pixel-art style), a soft rim and
// an emissive "hit flash".
uniform vec4 albedo : source_color = vec4(1.0);
uniform sampler2D albedo_tex : source_color, filter_nearest, repeat_enable, hint_default_white;
uniform vec2 uv_scale = vec2(1.0);
uniform vec4 shadow_tint : source_color = vec4(0.32, 0.26, 0.55, 1.0);
uniform vec4 emission : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float emission_energy = 1.0;
uniform float rim_strength = 0.35;
uniform vec4 flash_color : source_color = vec4(1.0);
uniform float flash = 0.0;
uniform float alpha = 1.0;
uniform vec4 belly : source_color = vec4(1.0);
uniform float belly_amount = 0.0;
uniform float emission_from_color = 0.0;

void vertex() {
	UV = UV * uv_scale;
}

void fragment() {
	vec3 base = albedo.rgb * texture(albedo_tex, UV).rgb * COLOR.rgb;
	// Lighter underside on creatures (two-tone, like pixel-art sprites).
	float down = (INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).y;
	base = mix(base, belly.rgb, belly_amount * step(down, -0.25));
	ALBEDO = base;
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	rim = step(0.45, rim) * rim;
	EMISSION = (emission.rgb + base * emission_from_color) * emission_energy + base * rim * rim_strength + flash_color.rgb * flash;
#ifdef TOON_ALPHA
	ALPHA = alpha * albedo.a * COLOR.a;
#endif
}

void light() {
	float d = dot(NORMAL, LIGHT);
	float lit = smoothstep(0.0, 0.08, d) * ATTENUATION;
	float soft = smoothstep(-0.6, -0.2, d);
	// Shadowed side keeps a cool tint instead of going grey.
	vec3 band = mix(shadow_tint.rgb * (0.35 + 0.25 * soft), vec3(1.0), step(0.5, lit));
	DIFFUSE_LIGHT += band * LIGHT_COLOR / PI;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode specular_disabled, blend_mix, depth_draw_opaque;
#define TOON_ALPHA
#include "res://shaders/toon.gdshaderinc"
